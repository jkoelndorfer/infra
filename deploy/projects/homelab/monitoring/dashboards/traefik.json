        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "sum(rate(traefik_service_requests_total{namespace=~\"$namespace\"}[$__rate_interval]))",
          "legendFormat": "Request rate",
          "refId": "A",
          "range": true,
          "instant": false,
          "format": "time_series"
